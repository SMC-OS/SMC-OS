# Local development defaults. Copy this file to .env.local and adjust as needed.
APP_ENV=development
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Production builds must set both values in the build environment and use an
# absolute HTTPS API origin (no path, query, fragment, credentials, or loopback).
# APP_ENV=production
# NEXT_PUBLIC_API_URL=https://api.example.com
