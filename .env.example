# Backend environment configuration (GeoCore FastAPI app).
# Copy this file to .env and adjust if needed. .env is gitignored — never commit real credentials.

# Used by docker-compose.yml to configure the local PostgreSQL container.
POSTGRES_USER=simo
POSTGRES_PASSWORD=simo
POSTGRES_DB=simo_os
POSTGRES_PORT=5432

# Full SQLAlchemy connection string used by app/database/database.py.
# Must point at the same database described by the POSTGRES_* values above
# (or an external PostgreSQL instance if you're not using docker-compose).
DATABASE_URL=postgresql+psycopg://simo:simo@localhost:5432/simo_os

# Runtime mode. Use production only with the strict configuration below.
APP_ENV=development

# Development/test defaults keep local startup convenient. Production requires
# false, an explicit HTTPS-only origin list, and a timeout in (0, 2] seconds.
SEED_DATA_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
READINESS_TIMEOUT_SECONDS=2

# Development may use a relative local directory. Production UPLOAD_DIR must be
# an absolute, pre-mounted persistent path writable by the application user.
UPLOAD_DIR=./uploads

# Sprint 003: JWT auth config (app/core/config.py, app/auth/).
# Generate a real secret for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Sprint 003: seeded single owner account (app/auth/seed.py) — only created
# if the users table is empty. Change the password before any shared/deployed use.
SEED_ADMIN_EMAIL=owner@geocore.local
SEED_ADMIN_PASSWORD=change-me-on-first-login

# AI Provider selection — optional. The app runs fully normally with no
# provider configured; all AI features report themselves unavailable
# honestly rather than falling back to a limited builtin. Valid values:
# "openai", "gemini". Default: "openai" (preserves existing behaviour
# when OPENAI_API_KEY is set).
# AI_PROVIDER=openai

# OpenAI — optional. Used when AI_PROVIDER=openai. The app runs fully
# normally with this unset; AI features return 503 ("not configured")
# until a real key is added. Never required to run GeoCore.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Google Gemini — optional. Used when AI_PROVIDER=gemini. The app runs
# fully normally with this unset; AI features return 503 ("not configured")
# until a real key is added. Never required to run GeoCore.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Sprint 032 (Workstream A): Stripe billing (app/billing/). Optional — the
# app runs fully normally with these unset; every billing route returns
# 503 ("Billing is not configured") until they're added. Never hardcode a
# Price ID in source. Uncomment and fill in only when you're ready.
#
# Sprint 039 Production Readiness Defect Gate, Blocker 3 — widened from 2
# self-service plans to 4 (Starter/Team added). See
# docs/SPRINTS/sprint-039.md §14.3 for the exact locked pricing, the 8
# Stripe Products/Prices to create, and which of these 8 variables each
# one fills — STRIPE_PRICE_PRO_* / STRIPE_PRICE_BUSINESS_* must be
# repointed to NEW Price objects at the new amounts, not the pre-Sprint-039
# ones.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STARTER_MONTHLY=
# STRIPE_PRICE_STARTER_ANNUAL=
# STRIPE_PRICE_TEAM_MONTHLY=
# STRIPE_PRICE_TEAM_ANNUAL=
# STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_PRICE_PRO_ANNUAL=
# STRIPE_PRICE_BUSINESS_MONTHLY=
# STRIPE_PRICE_BUSINESS_ANNUAL=

# Where Stripe Checkout/Customer Portal redirect back to after
# completion/cancellation. Defaults to the local frontend dev server.
FRONTEND_BASE_URL=http://localhost:3000

# Sprint 038: transactional email via Resend (app/communications/). Optional
# — the app runs fully normally with these unset; every send resolves to a
# truthful "failed"/"unavailable" communication record until a real key is
# added. Never required to run GeoCore. Sends from a dedicated subdomain
# (never this domain's apex, which carries its own mail) — see
# docs/SPRINTS/sprint-038.md §4 for the exact DNS this requires and why.
# Uncomment and fill in only when you're ready to use it.
# RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=
# EMAIL_SENDING_DOMAIN=send.geocore.one
