# Backend environment configuration (GeoCore FastAPI app).
# Copy this file to .env and adjust if needed. .env is gitignored — never commit real credentials.

# Used by docker-compose.yml to configure the local PostgreSQL container.
POSTGRES_USER=simo
POSTGRES_PASSWORD=simo
POSTGRES_DB=simo_os
POSTGRES_PORT=5432

# Full SQLAlchemy connection string used by app/database/database.py.
# Must point at the same database described by the POSTGRES_* values above
# (or an external PostgreSQL instance if you're not using docker-compose).
DATABASE_URL=postgresql+psycopg://simo:simo@localhost:5432/simo_os

# Runtime mode. Use production only with the strict configuration below.
APP_ENV=development

# Development/test defaults keep local startup convenient. Production requires
# false, an explicit HTTPS-only origin list, and a timeout in (0, 2] seconds.
SEED_DATA_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
READINESS_TIMEOUT_SECONDS=2

# Development may use a relative local directory. Production UPLOAD_DIR must be
# an absolute, pre-mounted persistent path writable by the application user.
UPLOAD_DIR=./uploads

# Sprint 003: JWT auth config (app/core/config.py, app/auth/).
# Generate a real secret for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Sprint 003: seeded single owner account (app/auth/seed.py) — only created
# if the users table is empty. Change the password before any shared/deployed use.
SEED_ADMIN_EMAIL=owner@geocore.local
SEED_ADMIN_PASSWORD=change-me-on-first-login

# AI Quotation Generator v1 (app/quotes/ai_draft.py) — optional. The app
# runs fully normally with this unset; the feature simply returns 503
# ("not configured") until a real key is added. Never required to run
# GeoCore. Uncomment and fill in only when you're ready to use it.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Sprint 032 (Workstream A): Stripe billing (app/billing/). Optional — the
# app runs fully normally with these unset; every billing route returns
# 503 ("Billing is not configured") until they're added. Never hardcode a
# Price ID in source — see docs/SPRINTS/sprint-032.md §5 for exact Stripe
# Dashboard setup steps. Uncomment and fill in only when you're ready.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_PRICE_PRO_ANNUAL=
# STRIPE_PRICE_BUSINESS_MONTHLY=
# STRIPE_PRICE_BUSINESS_ANNUAL=

# Where Stripe Checkout/Customer Portal redirect back to after
# completion/cancellation. Defaults to the local frontend dev server.
FRONTEND_BASE_URL=http://localhost:3000
